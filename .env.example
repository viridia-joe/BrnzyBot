# BrnzyBot — environment variables
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# ── Discord ────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=

# ── Warcraft Logs API ──────────────────────────────────────────────────────
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# ── Anthropic (Claude API) ─────────────────────────────────────────────────
# Used by the LiteLLM proxy sidecar to call Claude for all model aliases.
ANTHROPIC_API_KEY=

# ── Guild defaults ─────────────────────────────────────────────────────────
HOME_GUILD_ID=
DEFAULT_REALM=dreamscythe
DEFAULT_REGION=us
CURRENT_PHASE=2

# ── Inference routing (set automatically by docker-compose — do not change) ──
# LITELLM_BASE_URL=http://litellm:4000
# LITELLM_API_KEY=sk-brnzybot
# MODEL_TRIAGE=gear-triage
