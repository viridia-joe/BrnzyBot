# BrnzyBot — environment variables
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# ── Discord ────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=

# ── Warcraft Logs API ──────────────────────────────────────────────────────
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# ── LLM layer (optional) ───────────────────────────────────────────────────
# Master switch for all model-backed features (natural-language routing,
# free-form Q&A, gear-priority prose, AI boss assignments). Default false.
#
# false → deterministic-only mode. All commands (/gearprio, /gearcheck, /strat,
#         /bossguide) work fully. No litellm container, no Anthropic key needed.
#         This is the right setting for the free-tier GCP e2-micro.
# true  → also start the proxy: `docker compose --profile llm up -d`, and set
#         ANTHROPIC_API_KEY below.
ENABLE_LLM=false

# ── Anthropic (Claude API) ─────────────────────────────────────────────────
# Only required when ENABLE_LLM=true. Used by the LiteLLM proxy to call Claude.
ANTHROPIC_API_KEY=

# ── Guild defaults ─────────────────────────────────────────────────────────
HOME_GUILD_ID=
DEFAULT_REALM=dreamscythe
DEFAULT_REGION=us
CURRENT_PHASE=2

# ── Inference routing (set automatically by docker-compose — do not change) ──
# LITELLM_BASE_URL=http://litellm:4000
# LITELLM_API_KEY=sk-brnzybot
# MODEL_TRIAGE=gear-triage

# ── Ports ──────────────────────────────────────────────────────────────────
# HEALTH_PORT=8081   # liveness endpoint (published by docker-compose)
